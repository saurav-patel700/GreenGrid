# Backend API URL (Points to your Render backend in production)
VITE_API_BASE_URL=https://your-backend-app.onrender.com/api

# Optional: WebSocket URL (Auto-derived from VITE_API_BASE_URL if left empty)
VITE_WS_URL=wss://your-backend-app.onrender.com

# Google OAuth 2.0 Web Client ID (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
