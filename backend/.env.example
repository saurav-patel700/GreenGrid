# GreenGrid Backend Configuration Environment Variables Example

# Django Core Settings
SECRET_KEY=django-insecure-greengrid-production-ready-key-change-me-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,greengrid.example

# Database Configuration (SQLite for local development, MySQL for production)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=greengrid_db
DB_USER=root
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Token Settings
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# Django Channels / WebSockets Configuration
CHANNELS_BACKEND=inmemory

# Media Files Root
MEDIA_ROOT=media/
MEDIA_URL=/media/
